# Copy to .env for local use and export the values into your shell environment.
# Use your own credential for the selected provider. TypeSafe is the default;
# Cloudflare-hosted TypeSafe Jev is selected with SR_PROVIDER=cloudflare.
# Never put a real credential in this example or commit your local .env.
TYPESAFE_API_KEY=
# SR_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional trusted service settings. Credentials are scoped to the HTTPS origin.
# Supply only the base origin; sr appends /v1/systemone exactly once.
# No URL credentials, query/fragment, or non-root path is accepted.
# TYPESAFE_ENDPOINT=https://api.typesafe.ai
# SR_MODEL=jev-latest

# Credential presence does not enable networking. Use --allow-network or the
# trusted user configuration setting network.enabled for remote evaluation.
