{
  "schema_version": 2,
  "suite": "transport",
  "tier": "runner-mechanics",
  "timeout_ms": 30000,
  "cases": [
    {
      "id": "stalled-dns",
      "mode": "refuse",
      "timeout_ms": 5000,
      "output_bytes": 8192,
      "expected_exit": 7,
      "expected_outcome": "refused",
      "assertions": ["safe_error_reporting"],
      "require_fault": true
    },
    {
      "id": "handshake-timeout",
      "mode": "refuse",
      "timeout_ms": 5000,
      "output_bytes": 8192,
      "expected_exit": 7,
      "expected_outcome": "refused",
      "assertions": ["safe_error_reporting"],
      "require_fault": true
    },
    {
      "id": "429-backoff",
      "mode": "refuse",
      "timeout_ms": 5000,
      "output_bytes": 8192,
      "expected_exit": 7,
      "expected_outcome": "refused",
      "assertions": ["safe_error_reporting"],
      "require_fault": true
    },
    {
      "id": "success-twin",
      "mode": "pass",
      "timeout_ms": 5000,
      "output_bytes": 8192,
      "expected_exit": 0,
      "expected_outcome": "ok",
      "assertions": ["safe_error_reporting"],
      "require_fault": false
    },
    {
      "id": "consented-live-smoke",
      "mode": "pass",
      "timeout_ms": 5000,
      "output_bytes": 8192,
      "expected_exit": 0,
      "expected_outcome": "ok",
      "assertions": ["smoke_valid"],
      "require_fault": false
    },
    {
      "id": "full-transport-suite",
      "mode": "pass",
      "timeout_ms": 5000,
      "output_bytes": 8192,
      "expected_exit": 0,
      "expected_outcome": "ok",
      "assertions": ["p1_gate_passed"],
      "require_fault": false
    }
  ]
}
