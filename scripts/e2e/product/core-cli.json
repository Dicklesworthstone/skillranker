        "rank_pipeline::test_ranked_flow_with_mock_jev",
        "rank_pipeline::test_low_need_abstention",
        "rank_pipeline::test_low_fit_abstention",
        "rank_pipeline::test_none_winner_abstention",
        "rank_pipeline::test_dry_run_preview_without_network",
        "rank_pipeline::test_cli_bare_sr_and_rank_flags"
