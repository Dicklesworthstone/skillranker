{
  "schema_version": 1,
  "suite": "cache",
  "tier": "rust-product-integration",
  "targets": [
    "cache_atomic_publication",
    "cache_fingerprint",
    "cache_namespace_isolation",
    "cache_policy_revocation",
    "cache_publication_fence",
    "coordination_contract",
    "rank_acceptance",
    "real_rank_coordination",
    "response_cache_contract",
    "storage_contract"
  ],
  "allowed_ignored": [
    {
      "test": "coordination_contract::qualified_store_child_reader",
      "reason": "owned subprocess entry point invoked by qualified_store_delivers_both_stages_across_processes"
    },
    {
      "test": "rank_acceptance::late_rerank_shutdown_contention_diagnostic",
      "reason": "manual contention diagnostic; ordinary deadline and late-publication controls remain unignored"
    },
    {
      "test": "storage_contract::crash_writer_child",
      "reason": "owned subprocess entry point invoked by abrupt_process_exit_preserves_only_committed_generation"
    }
  ],
  "cases": [
    {
      "id": "cache-isolation-and-invalidation",
      "assertions": [
        "cache_isolation_verified"
      ],
      "tests": [
        "cache_fingerprint::key_protection_and_generation",
        "cache_fingerprint::request_fingerprint_determinism_and_canonical_equivalence",
        "cache_fingerprint::request_fingerprint_stage_and_field_sensitivity",
        "cache_fingerprint::namespace_isolation_across_sessions_and_key_generations",
        "cache_fingerprint::decision_fingerprint_sensitivity",
        "cache_fingerprint::non_finite_policy_weights_rejected",
        "cache_fingerprint::event_delivery_duplicate_detection",
        "cache_namespace_isolation::eviction_preserves_distinct_namespaces_with_real_request_fingerprints",
        "cache_namespace_isolation::coordination_binds_field_boundaries_even_for_the_same_request_handle",
        "cache_namespace_isolation::cache_lookup_cannot_cross_namespaces_with_a_reused_request_handle",
        "response_cache_contract::per_stage_isolation",
        "response_cache_contract::shortlist_sensitivity_causes_rerank_miss_when_candidates_change",
        "response_cache_contract::truthful_freshness_and_no_ttl_renewal_on_read",
        "response_cache_contract::wall_clock_rollback_detected_and_rejected",
        "response_cache_contract::revision_mismatch_and_unversioned_alias_rules",
        "response_cache_contract::zero_cost_accounting_for_wholly_cached_executions",
        "response_cache_contract::stale_inspection_non_actionable_and_no_hook_fallback",
        "response_cache_contract::namespace_isolation_and_eviction",
        "response_cache_contract::a_stored_ttl_never_extends_freshness_past_ten_minutes",
        "cache_policy_revocation::stale_expired_entry_refuses_actionable_publication"
      ]
    },
    {
      "id": "stale-policy-authority-withheld",
      "assertions": [
        "cache_isolation_verified",
        "stale_policy_withheld"
      ],
      "tests": [
        "cache_policy_revocation::exact_hit_consumer_withholds_stale_exclusion_authority",
        "cache_policy_revocation::qualified_store_consumers_withhold_stale_exclusion_authority",
        "rank_acceptance::a_changed_exclusion_supersedes_the_evaluation"
      ]
    },
    {
      "id": "network-only-revocation-preserves-local",
      "assertions": [
        "cache_isolation_verified",
        "network_revocation_safe"
      ],
      "tests": [
        "cache_policy_revocation::qualified_cache_network_revocation_preserves_exact_local_hit_and_exposes_miss",
        "rank_acceptance::offline_serves_a_complete_cached_pair"
      ]
    },
    {
      "id": "no-cache-no-persist-isolation",
      "assertions": [
        "cache_isolation_verified",
        "no_cache_no_persist_clean"
      ],
      "tests": [
        "cache_policy_revocation::disabled_cache_and_persistence_do_not_open_the_production_store",
        "coordination_contract::metadata_completion_creates_neither_hidden_bodies_nor_an_alternate_store",
        "real_rank_coordination::no_cache_and_no_persist_preserve_documented_effects",
        "storage_contract::unsafe_ancestors_leaf_modes_and_relative_paths_are_refused"
      ]
    },
    {
      "id": "concurrent-lease-coordination-and-recovery",
      "assertions": [
        "cache_isolation_verified",
        "coordination_lease_recovery_verified"
      ],
      "tests": [
        "coordination_contract::qualified_store_delivers_both_stages_across_processes",
        "coordination_contract::qualified_store_refresh_does_not_preempt_an_active_owner",
        "coordination_contract::namespace_keys_acquire_independent_production_leases",
        "real_rank_coordination::ordinary_two_consumer_success_incurs_one_pair_and_subsequent_exact_offline_reuse",
        "real_rank_coordination::follower_nearing_deadline_while_leader_active_makes_zero_provider_attempts",
        "real_rank_coordination::stale_leader_superseded_cannot_overwrite_newer_cache_or_complete_lease",
        "real_rank_coordination::completed_lease_with_absent_pair_reacquires_leadership_before_fresh_evaluation",
        "real_rank_coordination::an_unacquirable_lease_sends_uncoordinated_instead_of_a_false_timeout",
        "real_rank_coordination::busy_optional_lease_completion_keeps_answer_without_claiming_completion",
        "cache_atomic_publication::pair_and_completion_survive_close_and_reopen_together",
        "cache_atomic_publication::failed_second_row_preserves_previous_pair_and_active_lease",
        "cache_atomic_publication::completed_publisher_cannot_replace_the_pair_again",
        "cache_atomic_publication::wrong_store_fence_leaves_both_databases_untouched",
        "cache_publication_fence::stale_owner_cannot_replace_successors_actual_cache_body",
        "cache_publication_fence::expired_owner_does_not_create_a_cache_response",
        "cache_publication_fence::publication_and_acquisition_share_the_actual_cache_writer",
        "storage_contract::real_writer_lock_is_bounded_and_retry_after_release_succeeds"
      ]
    }
  ]
}
